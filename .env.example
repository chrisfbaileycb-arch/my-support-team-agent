# Server Configuration
PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/myf.sqlite

# Google Gemini API Key (Required for live agent execution and model inference)
GEMINI_API_KEY=

# Optional: PostgreSQL / Supabase connection (if deploying with external Postgres)
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: Stripe Billing (Leave unset to keep billing in honest NOT CONFIGURED mode)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional: Google Workspace Integration (Leave unset to run in SANDBOX PREVIEW mode)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
